//kage:unit pixels

package main

// Src0: the phosphor buffer (the picture with its afterglow). Src1: the
// colour overlay's tint, the same size (DESIGN §11.2). Src2: the moon
// backdrop behind the half-mirror (§11.3), black until it has loaded.
// Coordinates are in source pixels (srcPos - imageSrc0Origin()), never
// imageDstSize(), which is the whole destination image; Src1 and Src2 are
// read at Src0's positions.

var Time float
var Dim float     // 1 normally, less while paused
var Scan float    // scanline strength, 0 when the lines would be too thin to show
var Columns float // the monitor's lines across the picture: it's on its side
var Bloom float   // the bloom's reach, in source pixels
var Back float     // the backdrop's brightness behind the tube
var BackEdge float // its brightness at and beyond the tube's edge

// warp bends the picture like the tube's curved face.
func warp(uv vec2) vec2 {
	c := uv*2 - 1
	c *= 1 + 0.04*dot(c.yx, c.yx)
	return c*0.5 + 0.5
}

func Fragment(dstPos vec4, srcPos vec2, color vec4) vec4 {
	o := imageSrc0Origin()
	s := imageSrc0Size()
	uv := warp((srcPos - o) / s)

	// The backdrop is seen through the glass, not on the tube: it's flat,
	// without the curve, lines or glow, and added to the picture (the
	// half-mirror). It is dimmer behind the tube's face, brightening
	// towards its edge to meet the glass art around it: gently at the
	// sides, where the glass runs on, quickly at the top and bottom, where
	// the bezel is close and the player and the UFO are.
	ex := min(uv.x, 1-uv.x)
	ey := min(uv.y, 1-uv.y)
	behind := smoothstep(0, 0.3, ex) * smoothstep(0, 0.04, ey)
	back := imageSrc2At(srcPos).rgb * mix(BackEdge, Back, behind)
	if min(ex, ey) < 0 {
		return vec4(back, 1)
	}

	p := o + uv*s

	// A cheap bloom: the centre and 8 neighbours.
	c := imageSrc0At(p).rgb
	b := vec3(0)
	for i := 0; i < 8; i++ {
		a := float(i) * 0.785398
		b += imageSrc0At(p + vec2(cos(a), sin(a))*Bloom).rgb
	}
	c += b / 8 * 0.45

	// The overlay's coloured strips sit on the tube's face, so they bend
	// with the picture. (Positions in every source are Src0's: Ebitengine
	// moves them to Src1 itself.)
	c *= imageSrc1At(p).rgb

	// The monitor is turned on its side: its lines run up and down.
	f := fract(uv.x * Columns)
	c *= 1 - Scan*0.3*(1-sin(f*3.14159))

	// A slightly blue-white phosphor, the corners a little darker, and a
	// faint flicker.
	c *= vec3(0.93, 0.96, 1.0)
	d := uv - 0.5
	c *= 1 - dot(d, d)*1.1
	c *= 0.99 + 0.01*sin(Time*60)

	return vec4(c*Dim+back, 1)
}
